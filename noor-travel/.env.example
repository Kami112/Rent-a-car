# Copy to .env and fill in. Real environment variables override this file.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# DB_PATH=./data/noor.db

# First admin account (created on first start if it doesn't exist)
ADMIN_EMAIL=admin@noortravel.sa
ADMIN_PASSWORD=change-me-now

# Company details shown on the site and on ZATCA tax invoices
COMPANY_VAT_NUMBER=300000000000003
COMPANY_CR_NUMBER=1010000000
COMPANY_TOURISM_LICENSE=73100000
COMPANY_ADDRESS=King Fahd Road, Al Olaya District, Riyadh 12211, Saudi Arabia
COMPANY_PHONE=+966 11 000 0000
COMPANY_WHATSAPP=966500000000
COMPANY_EMAIL=info@noortravel.sa

# sandbox = methods without keys use the built-in simulator; live = they are hidden
PAYMENTS_MODE=sandbox

# Moyasar — mada, Visa, Mastercard, Apple Pay, STC Pay (https://dashboard.moyasar.com)
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
# MOYASAR_FORM_VERSION=1.14.0

# Tabby — split in 4 (https://tabby.ai/business)
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=

# Tamara — split in 3/4 (https://tamara.co/business)
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_KEY=
# TAMARA_API_URL=https://api-sandbox.tamara.co
